FROM alpine:latest

ARG PB_VERSION=0.42.3
ARG PB_RELEASE_ID=g6762h1kvtb6s2s
ARG TARGETOS
ARG TARGETARCH

RUN apk add --no-cache \
    unzip \
    ca-certificates

# Download PocketBase
ADD https://ganigeorgiev.com/api/files/releases/${PB_RELEASE_ID}/pocketbase_${PB_VERSION}_${TARGETOS}_${TARGETARCH}.zip /tmp/pb.zip
RUN unzip /tmp/pb.zip -d /pb/ && \
    rm /tmp/pb.zip

EXPOSE 8090

# Start PocketBase
CMD ["/pb/pocketbase", "serve", "--http=0.0.0.0:8090"]
